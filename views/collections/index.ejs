<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Collections -  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap');
    body { font-family: 'Comic Neue', cursive; background-color: #f0f9ff; }
    .rainbow-text {
      background: linear-gradient(to right, #ff2400, #e81d1d, #e8b71d, #e3e81d, #1de840, #1ddde8, #2b1de8, #dd00f3);
      -webkit-background-clip: text;
      color: transparent;
      animation: rainbow 3s linear infinite;
      background-size: 400% 100%;
    }
    @keyframes rainbow { 0% {background-position:0% 50%} 100% {background-position:100% 50%} }
    
    /* Custom scrollbar for sidebar */
    .sidebar-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .sidebar-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.1);
    }
    .sidebar-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.3);
      border-radius: 3px;
    }
    .sidebar-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.5);
    }
    
    /* Responsive adjustments for extra small phones (320px-360px) */
    @media (max-width: 360px) {
      /* Sidebar adjustments */
      #sidebar {
        width: 240px;
      }
      
      /* Card adjustments */
      .collection-card {
        padding: 0.75rem;
      }
      
      .card-title {
        font-size: 0.875rem;
      }
      
      .card-amount {
        font-size: 1rem;
      }
      
      .card-label {
        font-size: 0.625rem;
      }
      
      .card-button {
        padding: 0.375rem 0.75rem;
        font-size: 0.625rem;
      }
      
      .status-badge {
        font-size: 0.5rem;
        padding: 0.125rem 0.375rem;
      }
      
      .user-avatar {
        height: 1.5rem;
        width: 1.5rem;
      }
      
      /* Navbar adjustments */
      .navbar-title {
        font-size: 0.75rem;
      }
      
      .header-icon {
        font-size: 1rem;
      }
      
      /* Footer adjustments */
      footer {
        font-size: 0.5rem;
        padding: 0.25rem;
      }
      
      /* Main content padding */
      .main-content {
        padding: 0.25rem;
      }
      
      /* Section spacing */
      .section-spacing {
        margin-bottom: 0.75rem;
      }
      
      /* Grid adjustments */
      .card-grid {
        gap: 0.5rem;
      }
      
      /* Empty state adjustments */
      .empty-state-icon {
        height: 2rem;
        width: 2rem;
      }
      
      .empty-state-text {
        font-size: 0.75rem;
      }
      
      .empty-state-subtext {
        font-size: 0.625rem;
      }
      
      /* Header section adjustments */
      .header-section {
        flex-wrap: nowrap;
      }
      
      .header-title {
        font-size: 1rem;
      }
      
      .header-button {
        padding: 0.25rem 0.5rem;
        font-size: 0.625rem;
      }
    }
    
    /* Adjustments for average phones (361px-414px) */
    @media (min-width: 361px) and (max-width: 414px) {
      /* Sidebar adjustments */
      #sidebar {
        width: 260px;
      }
      
      /* Card adjustments */
      .collection-card {
        padding: 1rem;
      }
      
      .card-title {
        font-size: 1rem;
      }
      
      .card-amount {
        font-size: 1.125rem;
      }
      
      .card-label {
        font-size: 0.75rem;
      }
      
      .card-button {
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
      }
      
      .status-badge {
        font-size: 0.625rem;
        padding: 0.25rem 0.5rem;
      }
      
      .user-avatar {
        height: 2rem;
        width: 2rem;
      }
      
      /* Navbar adjustments */
      .navbar-title {
        font-size: 0.875rem;
      }
      
      .header-icon {
        font-size: 1.25rem;
      }
      
      /* Footer adjustments */
      footer {
        font-size: 0.625rem;
        padding: 0.375rem;
      }
      
      /* Main content padding */
      .main-content {
        padding: 0.5rem;
      }
      
      /* Section spacing */
      .section-spacing {
        margin-bottom: 1rem;
      }
      
      /* Grid adjustments */
      .card-grid {
        gap: 0.75rem;
      }
      
      /* Empty state adjustments */
      .empty-state-icon {
        height: 2.5rem;
        width: 2.5rem;
      }
      
      .empty-state-text {
        font-size: 0.875rem;
      }
      
      .empty-state-subtext {
        font-size: 0.75rem;
      }
      
      /* Header section adjustments */
      .header-section {
        flex-wrap: nowrap;
      }
      
      .header-title {
        font-size: 1.125rem;
      }
      
      .header-button {
        padding: 0.375rem 0.75rem;
        font-size: 0.75rem;
      }
    }
    
    /* Adjustments for large phones/phablets (415px-480px) */
    @media (min-width: 415px) and (max-width: 480px) {
      /* Sidebar adjustments */
      #sidebar {
        width: 280px;
      }
      
      /* Card adjustments */
      .collection-card {
        padding: 1.25rem;
      }
      
      .card-title {
        font-size: 1.125rem;
      }
      
      .card-amount {
        font-size: 1.25rem;
      }
      
      .card-label {
        font-size: 0.875rem;
      }
      
      .card-button {
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
      }
      
      .status-badge {
        font-size: 0.75rem;
        padding: 0.375rem 0.75rem;
      }
      
      .user-avatar {
        height: 2.5rem;
        width: 2.5rem;
      }
      
      /* Navbar adjustments */
      .navbar-title {
        font-size: 1rem;
      }
      
      .header-icon {
        font-size: 1.5rem;
      }
      
      /* Footer adjustments */
      footer {
        font-size: 0.75rem;
        padding: 0.5rem;
      }
      
      /* Main content padding */
      .main-content {
        padding: 0.75rem;
      }
      
      /* Section spacing */
      .section-spacing {
        margin-bottom: 1.25rem;
      }
      
      /* Grid adjustments */
      .card-grid {
        gap: 1rem;
      }
      
      /* Empty state adjustments */
      .empty-state-icon {
        height: 3rem;
        width: 3rem;
      }
      
      .empty-state-text {
        font-size: 1rem;
      }
      
      .empty-state-subtext {
        font-size: 0.875rem;
      }
      
      /* Header section adjustments */
      .header-section {
        flex-wrap: nowrap;
      }
      
      .header-title {
        font-size: 1.25rem;
      }
      
      .header-button {
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
      }
    }
    
    /* Landscape mode adjustments (up to 768px) */
    @media (max-width: 768px) and (orientation: landscape) {
      /* Sidebar adjustments */
      #sidebar {
        width: 220px;
      }
      
      /* Card adjustments */
      .collection-card {
        padding: 0.75rem;
      }
      
      .card-title {
        font-size: 0.875rem;
      }
      
      .card-amount {
        font-size: 1rem;
      }
      
      .card-label {
        font-size: 0.625rem;
      }
      
      .card-button {
        padding: 0.375rem 0.75rem;
        font-size: 0.625rem;
      }
      
      .status-badge {
        font-size: 0.5rem;
        padding: 0.125rem 0.375rem;
      }
      
      .user-avatar {
        height: 1.5rem;
        width: 1.5rem;
      }
      
      /* Navbar adjustments */
      .navbar-title {
        font-size: 0.75rem;
      }
      
      .header-icon {
        font-size: 0.875rem;
      }
      
      /* Footer adjustments */
      footer {
        font-size: 0.5rem;
        padding: 0.25rem;
      }
      
      /* Main content padding */
      .main-content {
        padding: 0.25rem;
      }
      
      /* Section spacing */
      .section-spacing {
        margin-bottom: 0.5rem;
      }
      
      /* Grid adjustments */
      .card-grid {
        gap: 0.5rem;
      }
      
      /* Empty state adjustments */
      .empty-state-icon {
        height: 1.75rem;
        width: 1.75rem;
      }
      
      .empty-state-text {
        font-size: 0.625rem;
      }
      
      .empty-state-subtext {
        font-size: 0.5rem;
      }
      
      /* Landscape specific adjustments */
      .landscape-grid-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      
      /* Header section adjustments */
      .header-section {
        flex-wrap: nowrap;
      }
      
      .header-title {
        font-size: 0.875rem;
      }
      
      .header-button {
        padding: 0.25rem 0.5rem;
        font-size: 0.625rem;
      }
    }
  </style>
</head>
<body class="min-h-screen bg-gray-100">

  <div class="flex h-screen overflow-hidden">

    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-gradient-to-b from-blue-600 to-purple-700 text-white p-4 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50 flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-3">
          <i class="fas fa-school text-2xl"></i>
          <span class="text-xl font-bold">  Dashboard</span>
        </div>
        <button id="closeSidebar" class="md:hidden text-white text-2xl">
          <i class="fas fa-times"></i>
        </button>
      </div>

            <nav class="space-y-1 flex-1 overflow-y-auto sidebar-scroll pb-4">
        <!-- Dashboard -->
        <a href="/dashboard" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-home w-5 text-center"></i> <span class="text-sm">Home</span>
        </a>

        <!-- Students -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Students</p>
        </div>
        <a href="/students/biodata" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-id-card w-5 text-center"></i> <span class="text-sm">Student Biodata</span>
        </a>
        <a href="/students/view" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-users w-5 text-center"></i> <span class="text-sm">View Students</span>
        </a>

        <!-- Teachers (Admins only) -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Teachers</p>
        </div>
        <a href="/teachers/add" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-chalkboard-teacher w-5 text-center"></i> <span class="text-sm">Add Teacher</span>
        </a>
        <a href="/teachers/view" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-user-tie w-5 text-center"></i> <span class="text-sm">View Teachers</span>
        </a>

        <!-- Subjects -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Subjects</p>
        </div>
        <a href="/subjects/add" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-book w-5 text-center"></i> <span class="text-sm">Add Subject</span>
        </a>
        <a href="/subjects/view" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-book-open w-5 text-center"></i> <span class="text-sm">View Subjects</span>
        </a>

        <!-- Results -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Results</p>
        </div>
        <a href="/results/add" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-file-circle-plus w-5 text-center"></i> <span class="text-sm">Add Result</span>
        </a>
        <a href="/results/view" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-list w-5 text-center"></i> <span class="text-sm">View Results</span>
        </a>
        <a href="/results/viewClassResult" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-table w-5 text-center"></i> <span class="text-sm">View Class Results</span>
        </a>

        <!-- Admin Only -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Admin</p>
        </div>
        <a href="/admin/sessions" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-calendar-plus w-5 text-center"></i> <span class="text-sm">Add Session</span>
        </a>
        <a href="/generate" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-key w-5 text-center"></i> <span class="text-sm">Generate PINs</span>
        </a>
        <a href="/pins" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-lock w-5 text-center"></i> <span class="text-sm">Created PINs</span>
        </a>
        <a href="/collections/new" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-money-bill-wave w-5 text-center"></i> <span class="text-sm">New Collection</span>
        </a>
        <a href="/collections" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-money-check-alt w-5 text-center"></i> <span class="text-sm">View Collections</span>
        </a>
        <a href="/promotion" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-graduation-cap w-5 text-center"></i> <span class="text-sm">Bulk Promotion</span>
        </a>
        <a href="/admin/school-info" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-school w-5 text-center"></i> <span class="text-sm">School Info</span>
        </a>
        <a href="/admin/school-profile" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-user w-5 text-center"></i> <span class="text-sm">School Profile</span>
        </a>
      </nav>
      <div class="pt-4 border-t border-blue-500">
        <div class="flex items-center justify-center text-xs text-blue-200">
          <i class="fas fa-copyright mr-1"></i>  
        </div>
      </div>
    </aside>

    <!-- Overlay -->
    <div id="overlay" class="fixed inset-0 bg-black bg-opacity-50 hidden z-40 md:hidden"></div>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col md:ml-64">

      <!-- Navbar -->
      <div class="bg-gradient-to-r from-blue-500 to-purple-600 p-2 md:p-6 text-white flex items-center justify-between">
        <div class="flex items-center justify-between w-full">
          <h1 class="navbar-title text-lg md:text-2xl font-bold flex items-center">
            <i class="fas fa-money-check-alt header-icon mr-2 md:mr-3"></i>
            <span class="rainbow-text text-sm md:text-base">Collections</span>
          </h1>
          <button id="openSidebar" class="md:hidden text-xl">
            <i class="fas fa-bars"></i>
          </button>
        </div>
        <p class="hidden md:block text-blue-100 text-sm">Manage Payment Collections</p>
      </div>

      <!-- Main Page Content -->
      <div class="flex-1 overflow-y-auto main-content p-1 md:p-6">
        <div class="">
          <div class="header-section flex flex-nowrap items-center justify-between section-spacing mb-2 md:mb-6">
            <div class="flex items-center flex-grow min-w-0">
              <i class="fas fa-coins header-icon text-blue-600 text-xl md:text-2xl mr-2 md:mr-3"></i>
              <h1 class="header-title text-lg md:text-2xl font-bold text-blue-800 truncate">Payment Collections</h1>
            </div>
            <a href="/collections/new" class="header-button ml-2 px-2 py-1 md:px-4 md:py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center text-xs md:text-sm flex-shrink-0">
              <i class="fas fa-plus mr-1"></i> <span class="hidden sm:inline">New Collection</span><span class="sm:inline">New</span>
            </a>
          </div>
          
          <div class="card-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
            <% collections.forEach(collection => { %>
              <div style="padding:12px; " class="collection-card bg-white rounded-lg md:rounded-xl shadow border border-gray-200 m-2 p-2">
                <div class="flex justify-between items-start mb-3">
                  <div class="flex-1 min-w-0">
                    <h3 class="card-title font-bold text-gray-900 truncate"><%= collection.personName %></h3>
                    <% if (collection.description) { %>
                      <p class="text-xs text-gray-500 mt-1 truncate"><i class="fas fa-sticky-note mr-1"></i><%= collection.description %></p>
                    <% } %>
                  </div>
                  <div class="user-avatar bg-blue-100 rounded-full flex items-center justify-center ml-2 flex-shrink-0">
                    <i class="fas fa-user text-blue-600"></i>
                  </div>
                </div>
                
                <div class="space-y-3">
                  <div class="flex justify-between items-center">
                    <span class="card-label text-gray-500">Total Amount</span>
                    <span class="card-amount font-medium text-gray-900">₦<%= collection.totalAmount.toFixed(2) %></span>
                  </div>
                  
                  <div class="flex justify-between items-center">
                    <span class="card-label text-gray-500">Remaining</span>
                    <span class="card-amount font-medium <%= collection.remainingAmount > 0 ? 'text-red-600' : 'text-green-600' %>">
                      ₦<%= collection.remainingAmount.toFixed(2) %>
                    </span>
                  </div>
                  
                  <div class="flex justify-between items-center">
                    <span class="card-label text-gray-500">Status</span>
                    <span class="status-badge px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                      <% if (collection.status === 'completed') { %>
                        bg-green-100 text-green-800
                      <% } else if (collection.status === 'partially paid') { %>
                        bg-yellow-100 text-yellow-800
                      <% } else { %>
                        bg-red-100 text-red-800
                      <% } %>
                    ">
                      <% if (collection.status === 'completed') { %>
                        <i class="fas fa-check-circle mr-1"></i> Done
                      <% } else if (collection.status === 'partially paid') { %>
                        <i class="fas fa-hourglass-half mr-1"></i> Partial
                      <% } else { %>
                        <i class="fas fa-exclamation-circle mr-1"></i> Pending
                      <% } %>
                    </span>
                  </div>
                  
                  <a href="/collections/<%= collection._id %>" class="card-button w-full block text-center bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    View Details
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
          
          <% if (collections.length === 0) { %>
            <div class="bg-white rounded-lg md:rounded-xl shadow border border-gray-200 p-2 md:p-8 text-center mt-4">
              <div class="flex justify-center mb-4">
                <div class="empty-state-icon bg-blue-100 rounded-full flex items-center justify-center">
                  <i class="fas fa-money-bill-wave text-blue-500 text-xl md:text-2xl"></i>
                </div>
              </div>
              <h3 class="empty-state-text font-medium text-gray-900 mb-2">No Collections Found</h3>
              <p class="empty-state-subtext text-gray-500 mb-4">Create a new collection to get started.</p>
              <a href="/collections/new" class="inline-flex items-center px-3 py-1.5 md:px-4 md:py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm md:text-base">
                <i class="fas fa-plus mr-2"></i> Create Your First Collection
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Footer -->
      <footer class="bg-gray-100 p-1 md:p-4 border-t-2 border-gray-200 text-center">
        <p class="text-gray-600 text-xs md:text-sm"><i class="fas fa-school mr-1"></i>   Collection Management</p>
      </footer>
    </div>
  </div>

  <!-- Sidebar Script -->
  <script>
    const sidebar = document.getElementById('sidebar');
    const openBtn = document.getElementById('openSidebar');
    const closeBtn = document.getElementById('closeSidebar');
    const overlay = document.getElementById('overlay');

    openBtn.addEventListener('click', () => {
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
    });

    closeBtn.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
    });

    overlay.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
    });
  </script>
</body>
</html>