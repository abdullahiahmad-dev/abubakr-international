<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Access Denied |  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap');
    body {
      font-family: 'Comic Neue', cursive;
      background-color: #f0f9ff;
    }
    .gradient-bg {
      background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    }
    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
      100% { transform: translateY(0px); }
    }
    .float-animation {
      animation: float 3s ease-in-out infinite;
    }
  </style>
</head>
<body class="min-h-screen gradient-bg flex flex-col items-center justify-center p-3">
  <!-- Main Content - Full Screen -->
  <div class="w-full max-w-md flex flex-col items-center justify-center">
    <!-- Icon with animation -->
    <div class="float-animation mb-4">
      <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center">
        <i class="fas fa-lock text-3xl text-red-600"></i>
      </div>
    </div>
    
    <!-- Error code -->
    <h1 class="text-5xl font-bold text-red-600 mb-2">403</h1>
    
    <!-- Title -->
    <h2 class="text-xl font-bold text-gray-800 mb-3 text-center">Access Denied</h2>
    
    <!-- Description -->
    <p class="text-gray-600 text-base mb-6 text-center">
      Sorry, you don't have permission to view this page.
    </p>
    
    <!-- Action buttons -->
    <div class="flex flex-col gap-3 w-full mb-6">
      <a href="/" 
         class="px-4 py-3 bg-blue-600 text-white rounded-lg font-medium shadow hover:bg-blue-700 transition flex items-center justify-center">
        <i class="fas fa-home mr-2"></i> Go Home
      </a>
      <button onclick="history.back()" 
              class="px-4 py-3 bg-white text-blue-600 border-2 border-blue-200 rounded-lg font-medium shadow hover:bg-blue-50 transition flex items-center justify-center">
        <i class="fas fa-arrow-left mr-2"></i> Go Back
      </button>
    </div>
    
    <!-- Helpful links -->
    <div class="w-full border-t border-gray-200 pt-4">
      <p class="text-gray-600 text-sm mb-3 text-center">You might be looking for:</p>
      <div class="flex flex-wrap justify-center gap-2">
        <a href="/dashboard" class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full hover:bg-blue-100 transition text-xs font-medium">Dashboard</a>
        <a href="/students/view" class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full hover:bg-blue-100 transition text-xs font-medium">Students</a>
        <a href="/teachers/view" class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full hover:bg-blue-100 transition text-xs font-medium">Teachers</a>
        <a href="/results/view" class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full hover:bg-blue-100 transition text-xs font-medium">Results</a>
      </div>
    </div>
  </div>
</body>
</html>