<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PIN Management -  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap');
    
    /* Custom scrollbar for sidebar */
    .sidebar-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .sidebar-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.1);
    }
    .sidebar-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.3);
      border-radius: 3px;
    }
    .sidebar-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.5);
    }
    body { font-family: 'Comic Neue', cursive; background-color: #f0f9ff; }
    .rainbow-text {
      background: linear-gradient(to right, #ff2400, #e81d1d, #e8b71d, #e3e81d, #1de840, #1ddde8, #2b1de8, #dd00f3);
      -webkit-background-clip: text;
      color: transparent;
      animation: rainbow 3s linear infinite;
      background-size: 400% 100%;
    }
    @keyframes rainbow { 0% {background-position:0% 50%} 100% {background-position:100% 50%} }
  </style>
</head>
<body class="min-h-screen bg-gray-100">

  <div class="flex h-screen overflow-hidden">

    <aside id="sidebar" style="overflow-y: scroll;" class="fixed inset-y-0 left-0 w-64 bg-gradient-to-b from-blue-600 to-purple-700 text-white p-4 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50 flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-3">
          <i class="fas fa-school text-2xl"></i>
          <span class="text-xl font-bold">  Dashboard</span>
        </div>
        <button id="closeSidebar" class="md:hidden text-white text-2xl">
          <i class="fas fa-times"></i>
        </button>
      </div>

            <nav class="space-y-1 flex-1 overflow-y-auto sidebar-scroll pb-4">
        <!-- Dashboard -->
        <a href="/dashboard" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-home w-5 text-center"></i> <span class="text-sm">Home</span>
        </a>

        <!-- Students -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Students</p>
        </div>
        <a href="/students/biodata" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-id-card w-5 text-center"></i> <span class="text-sm">Student Biodata</span>
        </a>
        <a href="/students/view" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-users w-5 text-center"></i> <span class="text-sm">View Students</span>
        </a>

        <!-- Teachers (Admins only) -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Teachers</p>
        </div>
        <a href="/teachers/add" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-chalkboard-teacher w-5 text-center"></i> <span class="text-sm">Add Teacher</span>
        </a>
        <a href="/teachers/view" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-user-tie w-5 text-center"></i> <span class="text-sm">View Teachers</span>
        </a>

        <!-- Subjects -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Subjects</p>
        </div>
        <a href="/subjects/add" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-book w-5 text-center"></i> <span class="text-sm">Add Subject</span>
        </a>
        <a href="/subjects/view" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-book-open w-5 text-center"></i> <span class="text-sm">View Subjects</span>
        </a>

        <!-- Results -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Results</p>
        </div>
        <a href="/results/add" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-file-circle-plus w-5 text-center"></i> <span class="text-sm">Add Result</span>
        </a>
        <a href="/results/view" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-list w-5 text-center"></i> <span class="text-sm">View Results</span>
        </a>
        <a href="/results/viewClassResult" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-table w-5 text-center"></i> <span class="text-sm">View Class Results</span>
        </a>

        <!-- Admin Only -->
        <div class="pt-2 pb-1">
          <p class="text-xs uppercase text-blue-200 px-2">Admin</p>
        </div>
        <a href="/admin/sessions" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-calendar-plus w-5 text-center"></i> <span class="text-sm">Add Session</span>
        </a>
        <a href="/generate" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-key w-5 text-center"></i> <span class="text-sm">Generate PINs</span>
        </a>
        <a href="/pins" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-lock w-5 text-center"></i> <span class="text-sm">Created PINs</span>
        </a>
        <a href="/collections/new" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-money-bill-wave w-5 text-center"></i> <span class="text-sm">New Collection</span>
        </a>
        <a href="/collections" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-money-check-alt w-5 text-center"></i> <span class="text-sm">View Collections</span>
        </a>
        <a href="/promotion" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-graduation-cap w-5 text-center"></i> <span class="text-sm">Bulk Promotion</span>
        </a>
        <a href="/admin/school-info" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-school w-5 text-center"></i> <span class="text-sm">School Info</span>
        </a>
        <a href="/admin/school-profile" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-blue-500 transition">
          <i class="fas fa-user w-5 text-center"></i> <span class="text-sm">School Profile</span>
        </a>
      </nav>
      
      <div class="pt-4 border-t border-blue-500">
        <div class="flex items-center justify-center text-xs text-blue-200">
          <i class="fas fa-copyright mr-1"></i>  
        </div>
      </div>
    </aside>

    <!-- Overlay -->
    <div id="overlay" class="fixed inset-0 bg-black bg-opacity-50 hidden z-40 md:hidden"></div>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col md:ml-64">

      <!-- Navbar -->
      <div class="bg-gradient-to-r from-blue-500 to-purple-600 p-4 md:p-6 text-white flex items-center justify-between">
        <div class="flex items-center justify-between w-full">
          <h1 class="text-lg md:text-2xl font-bold flex items-center">
            <i class="fas fa-key mr-2 md:mr-3"></i>
            <span class="rainbow-text text-sm md:text-base">PIN Management</span>
          </h1>
          <button id="openSidebar" class="md:hidden text-xl">
            <i class="fas fa-bars"></i>
          </button>
        </div>
        <p class="hidden md:block text-blue-100 text-sm">Manage Examination Access PINs</p>
      </div>

      <!-- Main Page Content -->
      <div class="flex-1 overflow-y-auto p-3 md:p-6">
        <!-- Filter Form -->
        <div class="bg-white p-4 md:p-6 rounded-lg md:rounded-xl shadow border border-gray-200 mb-4 md:mb-6">
          <h2 class="text-base md:text-lg font-semibold mb-3 md:mb-4">Filter Pins</h2>
          <form method="GET" action="/pins" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
            <div>
              <label class="block text-gray-700 font-medium mb-1 md:mb-2 text-sm">Session</label>
              <select name="session" class="w-full px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="all">All Sessions</option>
                <% sessions.forEach(s => { %>
                  <option value="<%= s._id %>" <%= selectedSession === s._id.toString() ? 'selected' : '' %>>
                    <%= s.name %>
                  </option>
                <% }) %>
              </select>
            </div>
            
            <div>
              <label class="block text-gray-700 font-medium mb-1 md:mb-2 text-sm">Term</label>
              <select name="term" class="w-full px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="all">All Terms</option>
                <option value="First Term" <%= selectedTerm === 'First Term' ? 'selected' : '' %>>First Term</option>
                <option value="Second Term" <%= selectedTerm === 'Second Term' ? 'selected' : '' %>>Second Term</option>
                <option value="Third Term" <%= selectedTerm === 'Third Term' ? 'selected' : '' %>>Third Term</option>
              </select>
            </div>
            
            <div>
              <label class="block text-gray-700 font-medium mb-1 md:mb-2 text-sm">Status</label>
              <select name="status" class="w-full px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="all" <%= filterStatus === 'all' ? 'selected' : '' %>>All Status</option>
                <option value="unused" <%= filterStatus === 'unused' ? 'selected' : '' %>>Unused</option>
                <option value="active" <%= filterStatus === 'active' ? 'selected' : '' %>>Active</option>
                <option value="expired" <%= filterStatus === 'expired' ? 'selected' : '' %>>Expired</option>
              </select>
            </div>
            
            <div class="flex items-end">
              <button type="submit" class="bg-blue-600 text-white px-4 py-2 text-sm rounded-lg hover:bg-blue-700 transition w-full">
                Filter
              </button>
            </div>
          </form>
        </div>
        
        <!-- Pins Table -->
        <div class="bg-white p-4 md:p-6 rounded-lg md:rounded-xl shadow border border-gray-200">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 space-y-3 sm:space-y-0">
            <h2 class="text-base md:text-lg font-semibold">All PIN Codes</h2>
            <div class="flex flex-wrap gap-2">
              <a href="/download-csv" class="bg-green-600 text-white px-3 py-1.5 md:px-4 md:py-2 text-sm rounded-lg hover:bg-green-700 transition flex items-center">
                <i class="fas fa-file-csv mr-1"></i> <span class="hidden sm:inline">Export CSV</span>
              </a>
              <a href="/download-excel" class="bg-blue-600 text-white px-3 py-1.5 md:px-4 md:py-2 text-sm rounded-lg hover:bg-blue-700 transition flex items-center">
                <i class="fas fa-file-excel mr-1"></i> <span class="hidden sm:inline">Export Excel</span>
              </a>
              <a href="/generate" class="bg-purple-600 text-white px-3 py-1.5 md:px-4 md:py-2 text-sm rounded-lg hover:bg-purple-700 transition flex items-center">
                <i class="fas fa-plus mr-1"></i> <span class="hidden sm:inline">Generate New Pins</span><span class="sm:inline">New</span>
              </a>
            </div>
          </div>
          
          <% if (pins.length > 0) { %>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-100">
                  <tr>
                    <th class="px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">PIN</th>
                    <th class="px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Session</th>
                    <th class="px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Term</th>
                    <th class="px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="hidden sm:table-cell px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Usage</th>
                    <th class="hidden md:table-cell px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">First Used By</th>
                    <th class="hidden lg:table-cell px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Used By</th>
                    <th class="hidden lg:table-cell px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Used</th>
                    <th class="hidden sm:table-cell px-2 md:px-4 py-2 md:py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <% pins.forEach(pin => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-2 md:px-4 py-2 md:py-3 whitespace-nowrap font-mono text-xs md:text-sm text-gray-900"><%= pin.code %></td>
                      <td class="px-2 md:px-4 py-2 md:py-3 whitespace-nowrap text-xs md:text-sm text-gray-500"><%= pin.session ? pin.session.name : 'N/A' %></td>
                      <td class="px-2 md:px-4 py-2 md:py-3 whitespace-nowrap text-xs md:text-sm text-gray-500"><%= pin.term %></td>
                      <td class="px-2 md:px-4 py-2 md:py-3 whitespace-nowrap text-xs md:text-sm">
                        <% if (pin.status === 'unused') { %>
                          <span class="px-2 py-1 rounded-full text-xs bg-yellow-100 text-yellow-800">Unused</span>
                        <% } else if (pin.status === 'active') { %>
                          <span class="px-2 py-1 rounded-full text-xs bg-green-100 text-green-800">Active</span>
                        <% } else if (pin.status === 'expired') { %>
                          <span class="px-2 py-1 rounded-full text-xs bg-red-100 text-red-800">Expired</span>
                        <% } %>
                      </td>
                      <td class="hidden sm:table-cell px-2 md:px-4 py-2 md:py-3 whitespace-nowrap text-xs md:text-sm text-gray-500">
                        <div class="flex items-center">
                          <span class="mr-1"><%= pin.usageCount || 0 %>/5</span>
                          <div class="w-12 md:w-16 bg-gray-200 rounded-full h-2">
                            <div class="bg-blue-600 h-2 rounded-full" style="width: <%= (pin.usageCount || 0) * 20 %>%"></div>
                          </div>
                        </div>
                      </td>
                      <td class="hidden md:table-cell px-2 md:px-4 py-2 md:py-3 whitespace-nowrap text-xs md:text-sm text-gray-500">
                        <%= pin.firstUsedBy ? pin.firstUsedBy.adminNo || pin.firstUsedBy : 'N/A' %>
                      </td>
                      <td class="hidden lg:table-cell px-2 md:px-4 py-2 md:py-3 whitespace-nowrap text-xs md:text-sm text-gray-500"><%= pin.usedBy || 'N/A' %></td>
                      <td class="hidden lg:table-cell px-2 md:px-4 py-2 md:py-3 whitespace-nowrap text-xs md:text-sm text-gray-500">
                        <%= pin.usedAt ? new Date(pin.usedAt).toLocaleDateString() : 'N/A' %>
                      </td>
                      <td class="hidden sm:table-cell px-2 md:px-4 py-2 md:py-3 whitespace-nowrap text-xs md:text-sm text-gray-500">
                        <%= new Date(pin.createdAt).toLocaleDateString() %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-6 md:py-8">
              <i class="fas fa-key text-3xl md:text-4xl text-gray-300 mb-2"></i>
              <p class="text-gray-500 text-base md:text-lg">No pins found matching your criteria.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Footer -->
      <div class="bg-gray-100 p-3 md:p-4 border-t-2 border-gray-200 text-center">
        <p class="text-gray-600 text-xs md:text-sm"><i class="fas fa-school mr-1"></i>   PIN Management</p>
      </div>
    </div>
  </div>

  <!-- Sidebar Script -->
  <script>
    const sidebar = document.getElementById('sidebar');
    const openBtn = document.getElementById('openSidebar');
    const closeBtn = document.getElementById('closeSidebar');
    const overlay = document.getElementById('overlay');

    openBtn.addEventListener('click', () => {
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
    });

    closeBtn.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
    });

    overlay.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
    });
  </script>
</body>
</html>