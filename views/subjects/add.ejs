        <!-- Subject Form -->
<form action="/subjects/add" method="POST" class="bg-white rounded-xl p-6 shadow border border-gray-200 mb-6">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Class Selection -->
    <div class="lg:col-span-2">
      <label class="block text-gray-700 font-medium mb-2">Select Classes:</label>
      
      <!-- Nursery Classes -->
      <div class="class-group">
        <div class="class-group-header">
          <h3 class="font-semibold text-blue-700">Nursery Classes</h3>
          <button type="button" onclick="toggleClassGroup('nursery')" class="select-all-btn bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600">
            Select All
          </button>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Pre-Nursery" id="class-pre-nursery" class="nursery-class">
            <label for="class-pre-nursery">Pre-Nursery</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Nursery 1" id="class-nursery-1" class="nursery-class">
            <label for="class-nursery-1">Nursery 1</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Nursery 2" id="class-nursery-2" class="nursery-class">
            <label for="class-nursery-2">Nursery 2</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Nursery 2B" id="class-nursery-2b" class="nursery-class">
            <label for="class-nursery-2b">Nursery 2B</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Nursery 3" id="class-nursery-3" class="nursery-class">
            <label for="class-nursery-3">Nursery 3</label>
          </div>
        </div>
      </div>
      
      <!-- Primary Classes -->
      <div class="class-group">
        <div class="class-group-header">
          <h3 class="font-semibold text-green-700">Primary Classes</h3>
          <button type="button" onclick="toggleClassGroup('primary')" class="select-all-btn bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600">
            Select All
          </button>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Primary 1" id="class-primary-1" class="primary-class">
            <label for="class-primary-1">Primary 1</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Primary 2" id="class-primary-2" class="primary-class">
            <label for="class-primary-2">Primary 2</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Primary 3" id="class-primary-3" class="primary-class">
            <label for="class-primary-3">Primary 3</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Primary 4" id="class-primary-4" class="primary-class">
            <label for="class-primary-4">Primary 4</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Primary 5" id="class-primary-5" class="primary-class">
            <label for="class-primary-5">Primary 5</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="Primary 6" id="class-primary-6" class="primary-class">
            <label for="class-primary-6">Primary 6</label>
          </div>
        </div>
      </div>
      
      <!-- Junior Secondary Classes -->
      <div class="class-group">
        <div class="class-group-header">
          <h3 class="font-semibold text-purple-700">Junior Secondary Classes</h3>
          <button type="button" onclick="toggleClassGroup('jss')" class="select-all-btn bg-purple-500 text-white px-3 py-1 rounded hover:bg-purple-600">
            Select All
          </button>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="JSS 1" id="class-jss-1" class="jss-class">
            <label for="class-jss-1">JSS 1</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="JSS 2" id="class-jss-2" class="jss-class">
            <label for="class-jss-2">JSS 2</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="JSS 3" id="class-jss-3" class="jss-class">
            <label for="class-jss-3">JSS 3</label>
          </div>
        </div>
      </div>
      
      <!-- Senior Secondary Classes -->
      <div class="class-group">
        <div class="class-group-header">
          <h3 class="font-semibold text-orange-700">Senior Secondary Classes</h3>
          <button type="button" onclick="toggleClassGroup('ss')" class="select-all-btn bg-orange-500 text-white px-3 py-1 rounded hover:bg-orange-600">
            Select All
          </button>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="SS 1" id="class-ss-1" class="ss-class">
            <label for="class-ss-1">SS 1</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="SS 2" id="class-ss-2" class="ss-class">
            <label for="class-ss-2">SS 2</label>
          </div>
          <div class="class-checkbox">
            <input type="checkbox" name="classLevels" value="SS 3" id="class-ss-3" class="ss-class">
            <label for="class-ss-3">SS 3</label>
          </div>
        </div>
      </div>
    </div>

    <!-- Stream Selection (for SS classes) -->
    <div id="streamSection" style="display:none;" class="lg:col-span-2">
      <label class="block text-gray-700 font-medium mb-2">Stream for SS Classes:</label>
      <div class="flex flex-wrap gap-4">
        <label class="flex items-center">
          <input type="radio" name="stream" value="General" checked class="mr-2">
          <span>General</span>
        </label>
        <label class="flex items-center">
          <input type="radio" name="stream" value="Science" class="mr-2">
          <span>Science</span>
        </label>
        <label class="flex items-center">
          <input type="radio" name="stream" value="Arts" class="mr-2">
          <span>Arts</span>
        </label>
        <label class="flex items-center">
          <input type="radio" name="stream" value="Commercial" class="mr-2">
          <span>Commercial</span>
        </label>
      </div>
      <p class="text-xs text-gray-500 mt-1">This will apply to all selected SS classes</p>
    </div>

    <!-- Subjects input with tag styling -->
    <div class="lg:col-span-2">
      <label class="block text-gray-700 font-medium mb-2">Subjects (press comma or enter to add):</label>
      <div id="tagInputContainer" class="tag-input-container" onclick="focusInput()">
        <input type="text" id="subjectInput" class="tag-input" placeholder="Type subject name and press comma or enter...">
      </div>
      <input type="hidden" name="subjects" id="subjectsHidden">
      <p class="text-xs text-gray-500 mt-1">Type a subject name and press comma (,) or Enter to add it as a tag</p>
    </div>
  </div>

  <div class="mt-6 flex justify-between">
    <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700">Save Subjects</button>
    <a href="/subjects/view" class="bg-gray-600 text-white px-6 py-2 rounded-lg hover:bg-gray-700">View Subjects</a>
  </div>
</form>

<script>
  const tagInputContainer = document.getElementById("tagInputContainer");
  const subjectInput = document.getElementById("subjectInput");
  const subjectsHidden = document.getElementById("subjectsHidden");
  const streamSection = document.getElementById("streamSection");
  
  // Array to store subjects
  let subjects = [];
  
  // Color palette for tags
  const tagColors = ['tag-blue', 'tag-green', 'tag-purple', 'tag-pink', 'tag-yellow', 'tag-red', 'tag-indigo', 'tag-teal'];
  
  // Monitor class selection changes
  document.querySelectorAll('input[name="classLevels"]').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      checkSSClassSelection();
    });
  });
  
  // Check if any SS class is selected
  function checkSSClassSelection() {
    const ssClasses = document.querySelectorAll('.ss-class:checked');
    if (ssClasses.length > 0) {
      streamSection.style.display = 'block';
    } else {
      streamSection.style.display = 'none';
    }
  }
  
  // Toggle class group selection
  function toggleClassGroup(group) {
    const checkboxes = document.querySelectorAll(`.${group}-class`);
    const allChecked = Array.from(checkboxes).every(cb => cb.checked);
    
    checkboxes.forEach(checkbox => {
      checkbox.checked = !allChecked;
    });
    
    checkSSClassSelection();
  }
  
  // Focus input when container is clicked
  function focusInput() {
    subjectInput.focus();
  }
  
  // Handle keypress events
  subjectInput.addEventListener('keydown', function(e) {
    if (e.key === ',' || e.key === 'Enter') {
      e.preventDefault();
      addSubject();
    }
  });
  
  // Handle paste events
  subjectInput.addEventListener('paste', function(e) {
    e.preventDefault();
    const pastedText = (e.clipboardData || window.clipboardData).getData('text');
    const pastedSubjects = pastedText.split(',').map(s => s.trim()).filter(s => s);
    
    pastedSubjects.forEach(subject => {
      if (subject && !subjects.includes(subject)) {
        subjects.push(subject);
        createTagElement(subject);
      }
    });
    
    updateHiddenInput();
    subjectInput.value = '';
  });
  
  // Add subject function
  function addSubject() {
    const subject = subjectInput.value.trim();
    
    if (subject && !subjects.includes(subject)) {
      subjects.push(subject);
      createTagElement(subject);
      updateHiddenInput();
    }
    
    subjectInput.value = '';
  }
  
  // Create tag element
  function createTagElement(subject) {
    const tag = document.createElement('div');
    tag.className = `subject-tag ${getRandomColor()}`;
    tag.innerHTML = `
      ${subject}
      <span class="tag-remove" onclick="removeSubject('${subject}')">
        <i class="fas fa-times"></i>
      </span>
    `;
    
    // Insert before the input
    tagInputContainer.insertBefore(tag, subjectInput);
  }
  
  // Get random color for tag
  function getRandomColor() {
    return tagColors[Math.floor(Math.random() * tagColors.length)];
  }
  
  // Remove subject
  function removeSubject(subject) {
    subjects = subjects.filter(s => s !== subject);
    updateHiddenInput();
    renderTags();
  }
  
  // Render all tags
  function renderTags() {
    // Clear existing tags
    const existingTags = tagInputContainer.querySelectorAll('.subject-tag');
    existingTags.forEach(tag => tag.remove());
    
    // Recreate tags
    subjects.forEach(subject => {
      createTagElement(subject);
    });
  }
  
  // Update hidden input
  function updateHiddenInput() {
    subjectsHidden.value = subjects.join(', ');
  }
  
  // Form submission validation
  document.querySelector('form').addEventListener('submit', function(e) {
    // Add any remaining text in input as a subject
    if (subjectInput.value.trim()) {
      addSubject();
    }
    
    // Check if at least one class is selected
    const selectedClasses = document.querySelectorAll('input[name="classLevels"]:checked');
    if (selectedClasses.length === 0) {
      e.preventDefault();
      alert('Please select at least one class');
      return;
    }
    
    // Check if at least one subject is added
    if (subjects.length === 0) {
      e.preventDefault();
      alert('Please add at least one subject');
      return;
    }
    
    // Check if SS classes are selected but no stream is chosen
    const ssClasses = document.querySelectorAll('.ss-class:checked');
    if (ssClasses.length > 0 && !document.querySelector('input[name="stream"]:checked')) {
      e.preventDefault();
      alert('Please select a stream for SS classes');
      return;
    }
  });
</script>

      </div>

      <!-- Footer -->
      <div class="bg-gray-100 p-4 border-t-2 border-gray-200 text-center">
        <p class="text-gray-600 text-sm"><i class="fas fa-school mr-1"></i> Abubakar International Model Subject Management</p>
      </div>
    </div>
  </div>

  <!-- Sidebar Script -->
  <script>
    const sidebar = document.getElementById('sidebar');
    const openBtn = document.getElementById('openSidebar');
    const closeBtn = document.getElementById('closeSidebar');
    const overlay = document.getElementById('overlay');

    openBtn.addEventListener('click', () => {
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
    });

    closeBtn.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
    });

    overlay.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
    });

    function closeModal(){
      document.getElementById("successModal").style.display="none";
    }
  </script>
</body>
</html>
