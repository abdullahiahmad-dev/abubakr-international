<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Subject</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap');
    body { font-family: 'Comic Neue', cursive; background-color: #f0f9ff; }
    /* Custom scrollbar for sidebar */
.sidebar-scroll::-webkit-scrollbar {
  width: 6px;
}
.sidebar-scroll::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.1);
}
.sidebar-scroll::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.3);
  border-radius: 3px;
}
.sidebar-scroll::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.5);
}
    .rainbow-text {
      background: linear-gradient(to right, #ff2400, #e81d1d, #e8b71d, #e3e81d, #1de840, #1ddde8, #2b1de8, #dd00f3);
      -webkit-background-clip: text;
      color: transparent;
      animation: rainbow 3s linear infinite;
      background-size: 400% 100%;
    }
    @keyframes rainbow { 0% {background-position:0% 50%} 100% {background-position:100% 50%} }
    
    /* Tag input styles */
    .tag-input-container {
      min-height: 50px;
      padding: 8px;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      cursor: text;
      transition: all 0.3s ease;
    }
    
    .tag-input-container:focus-within {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .subject-tag {
      display: inline-flex;
      align-items: center;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 500;
      animation: tagAppear 0.3s ease;
      transition: all 0.2s ease;
    }
    
    .subject-tag:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    
    .tag-remove {
      margin-left: 8px;
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 0.2s ease;
    }
    
    .tag-remove:hover {
      opacity: 1;
    }
    
    .tag-input {
      flex: 1;
      border: none;
      outline: none;
      min-width: 100px;
      font-size: 14px;
      padding: 4px;
    }
    
    @keyframes tagAppear {
      from {
        opacity: 0;
        transform: scale(0.8);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
    
    /* Color palette for tags */
    .tag-blue { background-color: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; }
    .tag-green { background-color: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .tag-purple { background-color: #e9d5ff; color: #6b21a8; border: 1px solid #c084fc; }
    .tag-pink { background-color: #fce7f3; color: #9f1239; border: 1px solid #f9a8d4; }
    .tag-yellow { background-color: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
    .tag-red { background-color: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .tag-indigo { background-color: #e0e7ff; color: #3730a3; border: 1px solid #a5b4fc; }
    .tag-teal { background-color: #ccfbf1; color: #134e4a; border: 1px solid #5eead4; }
    
    /* Class selection styles */
    .class-group {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 12px;
      margin-bottom: 16px;
      background-color: #f9fafb;
    }
    
    .class-group-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    
    .class-checkbox {
      display: flex;
      align-items: center;
      padding: 6px 0;
    }
    
    .class-checkbox input[type="checkbox"] {
      margin-right: 8px;
      width: 18px;
      height: 18px;
      cursor: pointer;
    }
    
    .class-checkbox label {
      cursor: pointer;
      font-size: 14px;
    }
    
    .select-all-btn {
      font-size: 12px;
      padding: 4px 8px;
      border-radius: 4px;
      transition: all 0.2s ease;
    }
    
    .select-all-btn:hover {
      transform: translateY(-1px);
    }
  </style>
</head>
<body class="min-h-screen bg-gray-100">

