<div class="bg-yellow-50 p-4 rounded border border-yellow-200 mb-4 no-print">
  <h3 class="font-bold text-yellow-800 mb-2">Position Calculation Method</h3>
  <div class="flex items-center space-x-4">
    <label class="flex items-center">
      <input type="radio" name="calculateByStream" value="false" 
        <%= calculateByStream !== "true" ? "checked" : "" %>
        onchange="updateCalculationMethod(this.value)" class="mr-2">
      Calculate position across all students
    </label>
    <label class="flex items-center">
      <input type="radio" name="calculateByStream" value="true" 
        <%= calculateByStream === "true" ? "checked" : "" %>
        onchange="updateCalculationMethod(this.value)" class="mr-2">
      Calculate position by stream (Science/Arts/Commercial)
    </label>
  </div>
</div>
<% } %>

<!-- Add this JavaScript function -->
<script>
  function updateCalculationMethod(value) {
    const url = new URL(window.location.href);
    url.searchParams.set('calculateByStream', value);
    window.location.href = url.toString();
  }
</script>
