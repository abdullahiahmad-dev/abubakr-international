  <script>
    // Sidebar toggle functionality
    const sidebar = document.getElementById('sidebar');
    const openBtn = document.getElementById('openSidebar');
    const closeBtn = document.getElementById('closeSidebar');
    const overlay = document.getElementById('overlay');

    openBtn.addEventListener('click', () => {
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });

    closeBtn.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
      document.body.style.overflow = 'auto';
    });

    overlay.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
      document.body.style.overflow = 'auto';
    });

// Add this after your existing JavaScript code
document.addEventListener('DOMContentLoaded', function() {
  const classSelect = document.getElementById('classLevel');
  const adminNoSelect = document.getElementById('adminNo');
  
  // Store all students in JavaScript
  const allStudents = <%- JSON.stringify(students) %>;
  
  // Function to update admin number dropdown based on selected class
  function updateAdminNoDropdown() {
    const selectedClass = classSelect.value;
    
    // Clear current options
    adminNoSelect.innerHTML = '<option value="">-- Select Student --</option>';
    
    if (selectedClass) {
      // Filter students by selected class
      const filteredStudents = allStudents.filter(student => student.classLevel === selectedClass);
      
      // Add filtered students to dropdown
      filteredStudents.forEach(student => {
        const option = document.createElement('option');
        option.value = student.adminNo;
        option.textContent = `${student.adminNo} — ${student.fullName}`;
        adminNoSelect.appendChild(option);
      });
    } else {
      // If no class selected, show all students
      allStudents.forEach(student => {
        const option = document.createElement('option');
        option.value = student.adminNo;
        option.textContent = `${student.adminNo} — ${student.fullName} (${student.classLevel})`;
        adminNoSelect.appendChild(option);
      });
    }
  }
  
  // Update dropdown when class selection changes
  classSelect.addEventListener('change', updateAdminNoDropdown);
  
  // Initialize dropdown on page load
  updateAdminNoDropdown();
});


           function downloadPDF() {
          const element = document.getElementById("result-container");
        
          // Get student name & session from EJS
          let studentName = "<%= student ? student.fullName : (studentResultsList && studentResultsList[0] ? studentResultsList[0].student.fullName : 'student') %>";
          let sessionName = "<%= student ? results[0].session.name : (studentResultsList && studentResultsList[0] ? studentResultsList[0].results[0].session.name : 'session') %>";
        
          // Clean invalid filename characters
          studentName = studentName.replace(/[^a-z0-9]/gi, "_").toUpperCase();
          sessionName = sessionName.replace(/[^a-z0-9]/gi, "_").toUpperCase();
        
          // IMPORTANT: Remove any existing page break styles first
          const studentResults = element.querySelectorAll('.student-result');
          studentResults.forEach((result) => {
            result.style.pageBreakBefore = '';
            result.style.pageBreakAfter = '';
            result.style.breakBefore = '';
            result.style.breakAfter = '';
          });
        
          const opt = {
            margin: [0.5, 0.5, 0.5, 0.5], // Add small margins
            filename: studentResults.length > 1 
              ? `CLASS_RESULTS_${sessionName}.pdf` 
              : `${studentName}_${sessionName}_RESULT.pdf`,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { 
              scale: 2,
              useCORS: true,
              allowTaint: true,
              logging: true, // Enable logging for debugging
              letterRendering: true
            },
            jsPDF: { 
              unit: 'mm', 
              format: 'a4', 
              orientation: 'portrait' 
            },
            pagebreak: { 
              mode: ['css', 'legacy'],
              before: '.page-break',
              after: ['#result-container'],
              avoid: ['tr', 'img', '.student-result']
            }
          };
        
          // Add a temporary class for page breaks
          studentResults.forEach((result, index) => {
            if (index > 0) {
              result.classList.add('page-break');
            }
          });
        
          // Generate and save PDF
          html2pdf().from(element).set(opt).save().then(() => {
            // Clean up: remove temporary classes
            studentResults.forEach((result) => {
              result.classList.remove('page-break');
            });
          });
        }
  </script>
</body>
</html>
